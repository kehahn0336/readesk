{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["2in1", "tablet", "phone"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST",
        "reason": "$string:file_access_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:documents_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:download_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "metadata": [
          {
            "name": "enable.remove.starting.window",
            "value": "true"
          }
        ],
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          },
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              { "scheme": "file", "utd": "general.epub", "linkFeature": "FileOpen" },
              { "scheme": "content", "utd": "general.epub", "linkFeature": "FileOpen" },
              { "scheme": "file", "utd": "com.adobe.pdf", "linkFeature": "FileOpen" },
              { "scheme": "content", "utd": "com.adobe.pdf", "linkFeature": "FileOpen" },
              { "scheme": "file", "utd": "com.amazon.mobi", "linkFeature": "FileOpen" },
              { "scheme": "content", "utd": "com.amazon.mobi", "linkFeature": "FileOpen" },
              { "scheme": "file", "utd": "com.amazon.azw", "linkFeature": "FileOpen" },
              { "scheme": "content", "utd": "com.amazon.azw", "linkFeature": "FileOpen" },
              { "scheme": "file", "utd": "com.amazon.azw3", "linkFeature": "FileOpen" },
              { "scheme": "content", "utd": "com.amazon.azw3", "linkFeature": "FileOpen" },
              { "scheme": "file", "utd": "general.ebook", "linkFeature": "FileOpen" },
              { "scheme": "content", "utd": "general.ebook", "linkFeature": "FileOpen" }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
